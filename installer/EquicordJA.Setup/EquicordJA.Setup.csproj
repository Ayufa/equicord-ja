<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>EquicordJA-Setup</AssemblyName>
    <RootNamespace>EquicordJA.Setup</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <!-- payload.zip と EquilotlCli.exe は CI (release-installer.yml) が publish 前にこのフォルダへ配置する -->
  <ItemGroup>
    <EmbeddedResource Include="equicord.asar" LogicalName="equicord.asar" />
    <EmbeddedResource Include="EquilotlCli.exe" LogicalName="EquilotlCli.exe" />
  </ItemGroup>

</Project>
